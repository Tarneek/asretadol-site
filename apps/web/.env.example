# Next.js (apps/web) — copy to .env.local for local overrides
# The monorepo root .env is also loaded via next.config.ts

# Required in production / staging builds (NODE_ENV=production).
# Optional in local development: defaults to http://localhost:3001/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Public site origin for SEO (canonical, OG, sitemap). No trailing slash.
# Production: https://niranews.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: emit standalone output for Docker
# NEXT_OUTPUT=standalone

# Keeps Server Action IDs stable across dev rebuilds and multi-instance deploys.
# Generate with: openssl rand -base64 32
# Must be set at build time and runtime (32-byte key, base64-encoded).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
