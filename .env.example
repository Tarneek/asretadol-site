# --- Shared ---
NODE_ENV=development

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=news
POSTGRES_PASSWORD=news_secret
POSTGRES_DB=news_platform
POSTGRES_PORT=5432

# --- API (NestJS) ---
API_PORT=3001

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=news
DATABASE_PASSWORD=news_secret
DATABASE_NAME=news_platform

# JWT secrets MUST be unique, random, and >= 32 characters.
# Production rejects secrets containing "change-me".
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API
# Local: http://localhost:3000
# Production: https://niranews.com,https://www.niranews.com
CORS_ORIGINS=http://localhost:3000

# Optional absolute path for blog article media (thumbnails, main, content).
# Leave UNSET for local development (default: apps/api/uploads/blog).
# UPLOAD_DIR=

# Legacy advertisement/story image + video dirs.
# Leave UNSET for local development (default: apps/web/public/uploads/news and .../videos).
# ARTICLE_UPLOAD_DIR=
# ARTICLE_VIDEO_UPLOAD_DIR=

# --- Production Docker media (server only; do not set these for local `pnpm dev`) ---
# Host directory bind-mounted into api/web/nginx. Create it once on the server:
#   sudo mkdir -p /srv/niranews/uploads/{blog/{thumbnails,main,content},news,videos}
#   sudo chown -R 1000:1000 /srv/niranews/uploads
# One-time copy from the old named volume (if you used uploads_data):
#   docker run --rm -v asretadol-site_uploads_data:/from -v /srv/niranews/uploads:/to alpine sh -c 'cp -a /from/. /to/'
# UPLOAD_HOST_DIR=/srv/niranews/uploads
# UPLOAD_UID=1000
# UPLOAD_GID=1000
# Inside the API container these paths are forced by docker-compose.prod.yml:
#   UPLOAD_DIR=/srv/uploads/blog
#   ARTICLE_UPLOAD_DIR=/srv/uploads/news
#   ARTICLE_VIDEO_UPLOAD_DIR=/srv/uploads/videos

# Rate limiting (requests per TTL window, per IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=20

# Set true behind reverse proxies / load balancers so rate limits use real client IP
TRUST_PROXY=false

# --- Web (Next.js) ---
# Public API base for browser + Server Components (must include /api prefix).
# Loaded from monorepo root .env and/or apps/web/.env.local (see apps/web/.env.example).
# Local dev: http://localhost:3001/api  |  Production: https://niranews.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Public site origin for canonical URLs, Open Graph, sitemap, robots (no trailing slash).
# Local dev: http://localhost:3000  |  Production: https://niranews.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stable Server Action IDs across rebuilds / replicas (32-byte key, base64).
# Generate: openssl rand -base64 32 — set at build time and runtime.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Admin seed (development only) ---
# Forced OFF in NODE_ENV=production
SEED_ADMIN_ENABLED=true
SEED_ADMIN_MOBILE=09120000000
SEED_ADMIN_EMAIL=admin@news.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin12!
SEED_ADMIN_DISPLAY_NAME=Administrator

# --- Demo content seed (development only; run: pnpm seed:demo) ---
# Skips if demo articles already exist unless SEED_DEMO_FORCE=1
SEED_DEMO_AUTHOR_PASSWORD=ChangeMeDemo12!
# SEED_DEMO_FORCE=1
