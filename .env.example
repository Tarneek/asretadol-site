# --- Shared ---
NODE_ENV=development

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=news
POSTGRES_PASSWORD=news_secret
POSTGRES_DB=news_platform
POSTGRES_PORT=5432

# --- API (NestJS) ---
API_PORT=3001

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=news
DATABASE_PASSWORD=news_secret
DATABASE_NAME=news_platform

# JWT secrets MUST be unique, random, and >= 32 characters.
# Production rejects secrets containing "change-me".
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Optional absolute path for article featured images (default: apps/web/public/uploads/news)
# ARTICLE_UPLOAD_DIR=C:\path\to\apps\web\public\uploads\news
# ARTICLE_VIDEO_UPLOAD_DIR=C:\path\to\apps\web\public\uploads\videos

# Rate limiting (requests per TTL window, per IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=20

# Set true behind reverse proxies / load balancers so rate limits use real client IP
TRUST_PROXY=false

# --- Web (Next.js) ---
# Public API base for browser + Server Components (must include /api prefix).
# Loaded from monorepo root .env and/or apps/web/.env.local (see apps/web/.env.example).
# Local dev: http://localhost:3001/api  |  Production: https://api.your-domain.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- Admin seed (development only) ---
# Forced OFF in NODE_ENV=production
SEED_ADMIN_ENABLED=true
SEED_ADMIN_MOBILE=09120000000
SEED_ADMIN_EMAIL=admin@news.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin12!
SEED_ADMIN_DISPLAY_NAME=Administrator

# --- Demo content seed (development only; run: pnpm seed:demo) ---
# Skips if demo articles already exist unless SEED_DEMO_FORCE=1
SEED_DEMO_AUTHOR_PASSWORD=ChangeMeDemo12!
# SEED_DEMO_FORCE=1
